{
  "schemaVersion": "1.0",
  "id": "remote-notifications-android",
  "packageId": "remote-notifications-android",
  "displayName": "远程通知",
  "version": "0.1.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "platforms": [
        "android-arm64",
        "android-x64"
      ],
      "assembly": "RemoteNotifications.Android.dll",
      "type": "RemoteNotifications.Android.RemoteNotificationsAndroidModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 30000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": true,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "inproc-or-sidecar",
      "systemMutation": "inproc-or-sidecar",
      "nativeHardware": "unsupported",
      "elevatedWrite": "unsupported",
      "externalProcess": "unsupported"
    }
  },
  "requires": [
    {
      "capability": "secret.store",
      "required": true,
      "reason": "Ed25519 签名私钥只能保存在平台凭据库中"
    },
    {
      "capability": "background.activity",
      "required": false,
      "reason": "用户开启后台接收后用于持有前台服务任务"
    },
    {
      "capability": "notification.desktop",
      "required": false,
      "reason": "把新通知投递到 Android 通知栏"
    }
  ],
  "permissions": [],
  "hotkeys": [],
  "staticIndexes": {
    "commands": "commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
