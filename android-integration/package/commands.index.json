      "category": "远程通知",
      "execution": {
        "type": "navigation",
        "toolId": "remote-notifications-android",
        "routeId": "main"
      }
    },
    {
      "id": "remote-notifications-android.status",
      "title": "查看通知状态",
      "subtitle": "签名、同步、后台与历史的当前状态",
      "kind": "action",
      "category": "远程通知",
      "execution": {
        "type": "module.execute"
      }
    },
    {
      "id": "remote-notifications-android.sync-now",
      "title": "立即同步通知",
      "subtitle": "执行一次签名拉取并投递新通知",
      "kind": "action",
      "category": "远程通知",
      "timeoutMs": 30000,
      "execution": {
        "type": "module.execute"
      }
    },
    {
      "id": "remote-notifications-android.inbox.summary",
      "title": "通知历史摘要",
      "subtitle": "统计历史条数、标签与最新消息",
      "kind": "action",
      "category": "远程通知",
      "execution": {
        "type": "module.execute"
      }
    },
    {
      "id": "remote-notifications-android.polling.start",
      "title": "开启后台接收",
