      "kind": "action",
      "category": "远程通知",
      "execution": {
        "type": "module.execute"
      }
    },
    {
      "id": "remote-notifications-android.inbox.clear",
      "title": "清空通知历史",
      "subtitle": "删除本机保存的全部通知记录",
      "kind": "action",
      "category": "远程通知",
      "execution": {
        "type": "module.execute"
