{
  "schemaVersion": "1.0",
  "id": "android-tools.notifications",
  "packageId": "android-tools-suite",
  "displayName": "Remote Notifications",
  "version": "0.2.0",
  "moduleSdk": "1.0",
  "entrypoints": [
    {
      "kind": "inproc-dotnet",
      "priority": 100,
      "assembly": "../../AndroidTools.MyPowerTools.dll",
      "type": "AndroidTools.MyPowerTools.RemoteNotificationsServiceObserverModule"
    }
  ],
  "capabilities": [
    "lifecycle",
    "status",
    "commands",
    "settings",
    "logs",
    "dashboardCard",
    "detailPage"
  ],
  "runtimePolicy": {
    "preferred": "inproc",
    "allowInProc": true,
    "inProcRules": {
      "maxCallMs": 3000,
      "allowNativeDll": false,
      "allowWindow": false,
      "allowBackgroundThreads": false,
      "loadContext": "collectible",
      "shadowCopy": true
    },
    "sidecarRules": {
      "readyTimeoutMs": 8000,
      "restartLimit": 4,
      "restartWindowSeconds": 30,
      "killProcessTree": true
    },
    "operationRules": {
      "status": "inproc-or-sidecar",
      "settings": "inproc-or-sidecar",
      "commandProvider": "inproc-or-sidecar",
      "longRunningCommand": "inproc-or-sidecar",
      "systemMutation": "broker-required",
      "nativeHardware": "sidecar-required",
      "elevatedWrite": "broker-required",
      "externalProcess": "sidecar-required"
    }
  },
  "requires": [
    {
      "capability": "service.user",
      "required": true,
      "reason": "启动和监督 Remote Notifications 后台服务"
    },
    {
      "capability": "notification.desktop",
      "required": false,
      "reason": "显示桌面通知"
    }
  ],
  "permissions": [],
  "staticIndexes": {
    "commands": "modules/notifications/commands.index.json"
  },
  "tools": [
    "ui/tool.json"
  ],
  "uiSurfaces": [
    "ui/dashboard-card.json",
    "ui/detail-page.json",
    "ui/settings.json",
    "ui/logs.json"
  ]
}
