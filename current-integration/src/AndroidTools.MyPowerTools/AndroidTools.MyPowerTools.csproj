<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Protocol" Version="0.2.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <Compile Include="..\MyPowerTools.Shell.Avalonia\Services\RemoteNotificationSettingsStore.cs"
             Link="Configuration\RemoteNotificationSettingsStore.cs" />
    <Compile Include="..\MyPowerTools.Shell.Avalonia\Services\RemoteNotificationHttpPoller.cs"
             Link="RemoteNotifications\RemoteNotificationHttpPoller.cs" />
    <Compile Include="..\MyPowerTools.Shell.Avalonia\Services\RemoteNotificationsLegacyStore.cs"
             Link="RemoteNotifications\RemoteNotificationsLegacyStore.cs" />
    <Compile Include="..\MyPowerTools.Shell.Avalonia\Services\RemoteNotificationSeenIdRing.cs"
             Link="RemoteNotifications\RemoteNotificationSeenIdRing.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);ANDROID_TOOLS_ADAPTER</DefineConstants>
    <ModulePackageRoot Condition="'$(ModulePackageRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\artifacts\package\android-tools-suite</ModulePackageRoot>
  </PropertyGroup>

  <Target Name="CopyModuleAssemblyToPackage" AfterTargets="Build">
    <MakeDir Directories="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModulePackageRoot)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
