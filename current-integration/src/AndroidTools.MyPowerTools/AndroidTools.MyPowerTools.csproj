<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="$(MyPowerToolsRepoRoot)\src\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
    <ProjectReference Include="$(MyPowerToolsRepoRoot)\src\MyPowerTools.Protocol\MyPowerTools.Protocol.csproj" />
    <Compile Include="..\MyPowerTools.Shell.Avalonia\Services\RemoteNotificationSettingsStore.cs"
             Link="Configuration\RemoteNotificationSettingsStore.cs" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);ANDROID_TOOLS_ADAPTER</DefineConstants>
    <MyPowerToolsRepoRoot Condition="'$(MyPowerToolsRepoRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\..\..'))</MyPowerToolsRepoRoot>
    <ModulePackageRoot Condition="'$(ModulePackageRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\artifacts\package\android-tools-suite</ModulePackageRoot>
  </PropertyGroup>

  <Target Name="ValidateMyPowerToolsRepoRoot" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(MyPowerToolsRepoRoot)\src\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj')" Text="MyPowerToolsRepoRoot must point to a MyPowerTools checkout." />
  </Target>

  <Target Name="CopyModuleAssemblyToPackage" AfterTargets="Build">
    <MakeDir Directories="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModulePackageRoot)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModulePackageRoot)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
