<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RemoteNotifications.Service</AssemblyName>
    <RootNamespace>RemoteNotifications.Service</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>
      Remote Notifications Service Unit process, supervised by MyPowerTools.ServiceManager.
      Owns the signed-pull polling loop, dedup, persisted history, topic indexing and
      platform-native banner dispatch independently of the Shell and Runner: Shell/Runner
      restarts never end this process. Provides named-pipe and Unix-domain-socket readiness
      probes plus a heartbeat so the ServiceManager can confirm liveness and re-adopt the
      still-running process across its own restart.
    </Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <RemoteNotificationsMacArchitecture>arm64</RemoteNotificationsMacArchitecture>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <RemoteNotificationsMacArchitecture>x86_64</RemoteNotificationsMacArchitecture>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\MyPowerTools.Abstractions\MyPowerTools.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\MyPowerTools.Ipc.Shared\MyPowerTools.Ipc.Shared.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\MyPowerTools.Platform.Abstractions\MyPowerTools.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\MyPowerTools.Platform.Mac\MyPowerTools.Platform.Mac.csproj" />
  </ItemGroup>

  <!-- The worker reuses the real product business logic. These linked files are the
       Surface originals, so the Shell and the independently supervised worker share one
       signed-pull, deduplication and persistence implementation. -->
  <ItemGroup>
    <Compile Include="..\RemoteNotifications.Surface\Services\RemoteNotificationSettingsStore.cs"
             Link="Shared\RemoteNotificationSettingsStore.cs" />
    <Compile Include="..\RemoteNotifications.Surface\Services\RemoteNotificationHttpPoller.cs"
             Link="Shared\RemoteNotificationHttpPoller.cs" />
    <Compile Include="..\RemoteNotifications.Surface\Services\RemoteNotificationsLegacyStore.cs"
             Link="Shared\RemoteNotificationsLegacyStore.cs" />
    <Compile Include="..\RemoteNotifications.Surface\Services\RemoteNotificationSeenIdRing.cs"
             Link="Shared\RemoteNotificationSeenIdRing.cs" />
    <None Include="native\RemoteNotificationsMac.mm" />
  </ItemGroup>

  <!-- Build a service-local native bridge on the target Mac. Its publish call waits for
       both the authorization callback and addNotificationRequest completion, so the worker
       increments its shown counter only after Notification Center accepts the request. -->
  <Target Name="BuildRemoteNotificationsMacNotificationBridge"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(RemoteNotificationsMacArchitecture)' != ''">
    <Exec Command="/usr/bin/xcrun clang++ -std=c++17 -fobjc-arc -dynamiclib -arch $(RemoteNotificationsMacArchitecture) -mmacosx-version-min=12.0 -framework AppKit -framework Foundation -framework UserNotifications -install_name @rpath/libRemoteNotificationsMac.dylib &quot;$(MSBuildProjectDirectory)/native/RemoteNotificationsMac.mm&quot; -o &quot;$(PublishDir)libRemoteNotificationsMac.dylib&quot;" />
  </Target>

</Project>
