{
  "id": "remote-notifications.service",
  "toolId": "remote-notifications",
  "displayName": "Remote Notifications Service",
  "exec": "../../Helpers/MyPowerTools Remote Notifications.app/Contents/MacOS/RemoteNotifications.Service",
  "arguments": [
    "--socket",
    "$TMPDIR/mypowertools/remote-notifications.core.sock",
    "--heartbeat-file",
    "~/Library/Application Support/MyPowerTools/state/remote-notifications.heartbeat",
    "--instance-token",
    "remote-notifications-service-v1"
  ],
  "workingDirectory": "../../Helpers/MyPowerTools Remote Notifications.app/Contents/MacOS",
  "environment": {
    "RemoteNotifications__Transport": "unix-domain-socket",
    "RemoteNotifications__UnixSocket__Path": "$TMPDIR/mypowertools/remote-notifications.core.sock",
    "MPT_REMOTE_NOTIFICATIONS_SOCKET": "$TMPDIR/mypowertools/remote-notifications.core.sock",
    "MPT_REMOTE_NOTIFICATIONS_SKIP_LEGACY_IMPORT": "1",
    "MPT_TOOL_DATA_ROOT": "~/Library/Application Support/MyPowerTools/state/tools/remote-notifications"
  },
  "autostart": true,
  "restartPolicy": { "maxRestarts": 5, "backoffMs": 2000 },
  "readiness": {
    "kind": "unix-socket",
    "address": "$TMPDIR/mypowertools/remote-notifications.core.sock",
    "timeoutMs": 8000
  },
  "stopTimeoutMs": 5000,
  "dataRoots": [
    "~/Library/Application Support/MyPowerTools/state/tools/remote-notifications"
  ],
  "dependsOn": [],
  "instanceToken": "remote-notifications-service-v1"
}
