<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MyPowerTools.UI.Controls"
             xmlns:vm="using:RemoteNotifications.Surface.ViewModels"
             x:Class="RemoteNotifications.Surface.Views.RemoteNotificationsView"
             x:DataType="vm:RemoteNotificationsViewModel"
             Background="{DynamicResource MptBrushTransparent}"
             MinHeight="520"
             ClipToBounds="True">
  <UserControl.Styles>
    <Style Selector="Button.label-chip">
      <Setter Property="Background" Value="{DynamicResource MptBrushControlFillDefault}" />
      <Setter Property="Foreground" Value="{DynamicResource MptBrushTextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushControlStrokeDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusBadge}" />
      <Setter Property="Padding" Value="{DynamicResource MptChipPadding}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="{DynamicResource MptFontSizeMeta}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.label-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushControlFillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
    </Style>
    <Style Selector="Button.label-chip.unread">
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushWarning}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.label-chip.selected">
      <Setter Property="Background" Value="{DynamicResource MptBrushAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource MptBrushAccentText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.notification-card">
      <Setter Property="Margin" Value="{DynamicResource MptGapBottomM}" />
      <Setter Property="Padding" Value="{DynamicResource MptUniformL}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MptRadiusCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource MptBrushCardBackground}" />
    </Style>
    <Style Selector="Border.notification-card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource MptBrushBorderStrong}" />
      <Setter Property="Background" Value="{DynamicResource MptBrushLayerAltBackground}" />
    </Style>
    <Style Selector="ListBox.notification-list">
      <Setter Property="Background" Value="{DynamicResource MptBrushTransparent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="{DynamicResource MptGapRightS}" />
    </Style>
    <Style Selector="ListBox.notification-list ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource MptBrushTransparent}" />
      <Setter Property="Padding" Value="{DynamicResource MptNoThickness}" />
      <Setter Property="Margin" Value="{DynamicResource MptNoThickness}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>
    <Style Selector="ListBox.notification-list ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource MptBrushTransparent}" />
    </Style>
    <Style Selector="ListBox.notification-list ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource MptBrushTransparent}" />
    </Style>
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="8" />
    </Style>
  </UserControl.Styles>

  <Grid MaxWidth="1280"
        HorizontalAlignment="Stretch"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
    <Grid Grid.Row="0"
          ColumnDefinitions="*,320,Auto"
          ColumnSpacing="14"
          MinHeight="48"
          Margin="0,0,0,8">
      <StackPanel Grid.Column="0"
                  VerticalAlignment="Center">
        <TextBlock Classes="MptPageTitle"
                   Text="{Binding Title}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding Subtitle}" />
        <Border Margin="0,4,0,0"
                Padding="8,5"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{Binding SystemHealthForeground}"
                Background="{Binding SystemHealthBackground}"
                IsVisible="{Binding HasSystemHealth}">
          <StackPanel Spacing="2">
            <TextBlock Text="CHRS notification health"
                       FontWeight="SemiBold"
                       Foreground="{Binding SystemHealthForeground}" />
            <TextBlock Text="{Binding SystemHealthText}"
                       TextWrapping="Wrap"
                       Foreground="{Binding SystemHealthForeground}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Expander Grid.Column="1"
                FontSize="{DynamicResource MptFontSizeMeta}"
                HorizontalContentAlignment="Stretch"
                ToolTip.Tip="Expand connection details"
                VerticalAlignment="Center"
                IsExpanded="False">
        <Expander.Header>
          <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                ColumnSpacing="8"
                MinHeight="32">
            <Border Width="20"
                    Height="20"
                    CornerRadius="{DynamicResource MptRadiusBadge}"
                    Background="{Binding StatusBackground}"
                    VerticalAlignment="Center">
              <Border Width="7"
                      Height="7"
                      CornerRadius="{DynamicResource MptRadiusBadge}"
                      Background="{Binding StatusForeground}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="3"
                       Text="{Binding MessageCountText}"
                       FontSize="{DynamicResource MptFontSizeMeta}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </Grid>
        </Expander.Header>
          <Grid ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="4"
                Margin="0,4,0,2">
            <TextBlock Text="{Binding Server}"
                       Classes="MptMeta"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Server}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding LastSyncText}"
                       Classes="MptMeta"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1"
                       Text="{Binding SyncResultText}"
                       Classes="MptMeta"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding Latest, StringFormat='Latest: {0}'}"
                       Classes="MptMeta"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2"
                       Text="{Binding Fetched, StringFormat='Fetched: {0}'}"
                       Classes="MptMeta" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding Shown, StringFormat='Shown: {0}'}"
                       Classes="MptMeta" />
          </Grid>
      </Expander>

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="14"
                  VerticalAlignment="Center">
      <controls:MptCheckBox
                            Content="Keep banners"
                            IsChecked="{Binding PersistentWindowsToasts, Mode=TwoWay}"
                            ToolTip.Tip="Keep Windows notification banners visible until dismissed"
                            IsVisible="{Binding IsInboxVisible}"
                            VerticalAlignment="Center" />
      <controls:MptButton
                          Content="Search"
                          Click="OnSearchClick"
                          ToolTip.Tip="Search notification content"
                          IsVisible="{Binding IsInboxVisible}"
                          VerticalAlignment="Center" />
      <controls:MptButton
                          Content="Clear all"
                          Click="OnClearClick"
                          ToolTip.Tip="Remove stored notifications"
                          IsVisible="{Binding IsInboxVisible}"
                          VerticalAlignment="Center" />
      <controls:MptButton Content="Claude Task"
                          Command="{Binding ShowClaudeTaskCommand}"
                          ToolTip.Tip="Auto-triggered Stops from Claude (task-notification, continue nudges)"
                          IsVisible="{Binding IsInboxVisible}"
                          VerticalAlignment="Center" />
      <Grid>
        <controls:MptButton Content="Settings"
                            Command="{Binding ShowSettingsCommand}"
                            IsVisible="{Binding IsInboxVisible}"
                            VerticalAlignment="Center" />
        <controls:MptButton Content="Back to inbox"
                            Command="{Binding ShowInboxCommand}"
                            IsVisible="{Binding IsSettingsVisible}"
                            VerticalAlignment="Center" />
        <controls:MptButton Content="Back to inbox"
                            Command="{Binding ShowInboxCommand}"
                            IsVisible="{Binding IsClaudeTaskVisible}"
                            VerticalAlignment="Center" />
      </Grid>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Margin="0,0,0,8"
            Padding="12"
            CornerRadius="{DynamicResource MptRadiusCard}"
            BorderBrush="{DynamicResource MptBrushBorder}"
            BorderThickness="1"
            Background="{DynamicResource MptBrushCardBackground}"
            IsVisible="{Binding IsSearchVisible}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10">
        <TextBlock Text="⌕"
                   FontSize="20"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="Search" />
        <controls:MptTextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search notification content"
                             KeyDown="OnSearchBoxKeyDown" />
        <TextBlock Grid.Column="2"
                   Text="{Binding SearchResultText}"
                   Classes="MptMeta"
                   VerticalAlignment="Center" />
        <controls:MptButton Grid.Column="3"
                            Content="Close"
                            Click="OnCloseSearchClick" />
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Classes="MptSettingsSection"
            Padding="20"
            CornerRadius="{DynamicResource MptRadiusCard}"
            BorderBrush="{DynamicResource MptBrushBorder}"
            BorderThickness="1"
            Background="{DynamicResource MptBrushCardBackground}"
            IsVisible="{Binding IsSettingsVisible}">
      <StackPanel Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Classes="MptSectionTitle" Text="Notification source" />
          <TextBlock Classes="MptPageSubtitle"
                     Text="Configure the signed feed used by this inbox and by module diagnostics. Changes take effect as soon as they are saved."
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnDefinitions="150,*,120"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="6">
          <TextBlock Text="Protocol" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Host" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="Port" FontWeight="SemiBold" />
          <controls:MptComboBox Grid.Row="1"
                                ItemsSource="{Binding ProtocolOptions}"
                                SelectedItem="{Binding ProtocolDraft, Mode=TwoWay}" />
          <controls:MptTextBox Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding HostDraft, Mode=TwoWay}"
                               PlaceholderText="message.example.com" />
          <controls:MptTextBox Grid.Row="1"
                               Grid.Column="2"
                               Text="{Binding PortDraft, Mode=TwoWay}"
                               PlaceholderText="8888" />
        </Grid>

        <Grid ColumnDefinitions="*,180"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="6">
          <TextBlock Text="Channel" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Poll interval (seconds)" FontWeight="SemiBold" />
          <controls:MptTextBox Grid.Row="1"
                               Text="{Binding ChannelDraft, Mode=TwoWay}"
                               PlaceholderText="default" />
          <controls:MptTextBox Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding PollIntervalDraft, Mode=TwoWay}"
                               PlaceholderText="5" />
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock Text="SSH private key path" FontWeight="SemiBold" />
          <controls:MptTextBox Text="{Binding PrivateKeyPathDraft, Mode=TwoWay}"
                               PlaceholderText="~/.ssh/id_ed25519" />
          <TextBlock Classes="MptMeta"
                     Text="{Binding PrivateKeyStatus}"
                     TextWrapping="Wrap" />
          <TextBlock Classes="MptMeta"
                     Text="Only the path is stored. Private-key contents are never displayed or copied into settings."
                     TextWrapping="Wrap" />
        </StackPanel>

        <controls:MptCheckBox Content="Keep Windows notification banners visible until dismissed"
                              IsChecked="{Binding KeepWindowsBannersDraft, Mode=TwoWay}" />

        <Border Padding="12"
                CornerRadius="{DynamicResource MptRadiusControl}"
                Background="{DynamicResource MptBrushSurfaceInset}"
                IsVisible="{Binding HasSettingsFeedback}">
          <TextBlock Text="{Binding SettingsFeedback}"
                     Foreground="{Binding SettingsFeedbackForeground}"
                     TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right">
          <controls:MptButton Content="Revert changes"
                              Command="{Binding ResetSettingsCommand}" />
          <controls:MptButton Content="Test connection and signing"
                              Command="{Binding TestSettingsCommand}" />
          <controls:MptButton Classes="MptPrimaryButton"
                              Content="Save and restart sync"
                              Command="{Binding SaveSettingsCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Padding="{DynamicResource MptUniformL}"
            CornerRadius="{DynamicResource MptRadiusCard}"
            BorderBrush="{DynamicResource MptBrushDanger}"
            BorderThickness="1"
            Background="{DynamicResource MptBrushWarningBackground}"
            IsVisible="{Binding ShowSyncError}">
      <Grid RowDefinitions="Auto,Auto"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
        <TextBlock Text="!"
                   Foreground="{DynamicResource MptBrushDanger}"
                   FontSize="{DynamicResource MptFontSizeCardTitle}"
                   VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Spacing="{DynamicResource MptSpacingXs}">
          <TextBlock Text="{Binding ErrorTitle}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding ErrorSummary}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource MptSpacingS}"
                    VerticalAlignment="Center">
          <controls:MptButton Content="{Binding ErrorDetailsActionLabel}"
                              Command="{Binding ToggleErrorDetailsCommand}" />
          <controls:MptButton Classes="MptPrimaryButton"
                              Content="Retry sync"
                              Command="{Binding RetryCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="{DynamicResource MptGapTopM}"
                      MaxHeight="116"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVisible="{Binding IsErrorDetailsExpanded}">
          <SelectableTextBlock Text="{Binding TechnicalErrorDetails}"
                               Padding="{DynamicResource MptCompactPadding}"
                               Background="{DynamicResource MptBrushSurfaceInset}"
                               FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                               FontSize="{DynamicResource MptFontSizeMeta}"
                               TextWrapping="Wrap" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Padding="0,8"
            BorderBrush="{DynamicResource MptBrushDivider}"
            BorderThickness="0,1,0,1"
            IsVisible="{Binding ShowInboxLabels}">
      <Grid>
        <ScrollViewer x:Name="LabelScroller"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled"
                      PointerWheelChanged="OnLabelScrollerPointerWheelChanged"
                      PointerPressed="OnLabelScrollerPointerPressed"
                      PointerMoved="OnLabelScrollerPointerMoved"
                      PointerReleased="OnLabelScrollerPointerReleased"
                      PointerCaptureLost="OnLabelScrollerPointerCaptureLost">
          <ItemsControl ItemsSource="{Binding Chips}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteNotificationLabelChipViewModel">
                <controls:MptButton Classes="label-chip"
                                    Margin="0,0,8,0"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.unread="{Binding IsUnread}"
                                    Content="{Binding Label}"
                                    Command="{Binding SelectCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="5"
          Margin="0,4,0,0"
          MinHeight="280"
          IsVisible="{Binding IsInboxVisible}">
      <ListBox x:Name="NotificationList"
               Classes="notification-list"
               ItemsSource="{Binding VisibleMessages}"
               SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RemoteNotificationMessageViewModel">
            <Border Classes="notification-card"
                    DoubleTapped="OnMessageDoubleTapped"
                    ContextRequested="OnMessageContextRequested"
                    ToolTip.Tip="Double-click to open the complete message"
                    AutomationProperties.Name="{Binding AccessibleLabel}">
              <Grid ColumnDefinitions="38,*"
                    ColumnSpacing="12">
                <Border Width="36"
                        Height="36"
                        CornerRadius="{DynamicResource MptRadiusBadge}"
                        Background="{Binding IconBackground}"
                        VerticalAlignment="Top">
                  <TextBlock Text="{Binding IconGlyph}"
                             Foreground="{Binding IconForeground}"
                             FontSize="{DynamicResource MptFontSizeCardTitle}"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1"
                            Spacing="{DynamicResource MptSpacingM}">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{DynamicResource MptSpacingS}">
                      <TextBlock Text="{Binding Label}"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <Border Padding="{DynamicResource MptCompactBadgePadding}"
                              CornerRadius="{DynamicResource MptRadiusControl}"
                              Background="{DynamicResource MptBrushSurfaceMuted}"
                              IsVisible="{Binding HasCustomChannel}">
                        <TextBlock Text="{Binding Channel}"
                                   Classes="MptMeta" />
                      </Border>
                      <Border Padding="{DynamicResource MptCompactBadgePadding}"
                              CornerRadius="{DynamicResource MptRadiusControl}"
                              Background="{DynamicResource MptBrushSurfaceMuted}"
                              IsVisible="{Binding HasSession}"
                              ToolTip.Tip="{Binding SessionId}">
                        <TextBlock Text="{Binding SessionDisplay}"
                                   Classes="MptMeta" />
                      </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding RelativeTime}"
                               Classes="MptMeta"
                               ToolTip.Tip="{Binding AbsoluteTime}"
                               VerticalAlignment="Center" />
                  </Grid>

                  <controls:MptMarkdownView Markdown="{Binding DisplayMessage}"
                                         IsPreview="True"
                                         MaxWidth="920"
                                         MaxHeight="160"
                                         ClipToBounds="True"
                                         HorizontalAlignment="Left" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Classes="MptEmptyState"
              IsVisible="{Binding ShowsEmptyOverlay}">
        <StackPanel Spacing="{DynamicResource MptSpacingS}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="○"
                     FontSize="{DynamicResource MptFontSizeSection}"
                     Foreground="{DynamicResource MptBrushTextMuted}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyOverlayText}"
                     Classes="MptPageSubtitle"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
