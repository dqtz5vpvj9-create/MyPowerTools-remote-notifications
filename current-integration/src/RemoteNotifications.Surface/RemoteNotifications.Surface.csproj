<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RemoteNotifications.Surface</AssemblyName>
    <RootNamespace>RemoteNotifications.Surface</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>RemoteNotifications.Surface</PackageId>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" GeneratePathProperty="true" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="MyPowerTools.ToolSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.AvaloniaSdk" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.UI" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.HostControl.Client" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Broker" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Platform.Abstractions" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Platform.Windows" Version="0.2.0" />
    <PackageReference Include="MyPowerTools.Protocol" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyPowerTools.Tests" />
    <ProjectReference Include="..\..\..\..\..\src\MyPowerTools.Ipc.Shared\MyPowerTools.Ipc.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgAvalonia_Controls_WebView)\lib\net10.0\Avalonia.Controls.WebView.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
